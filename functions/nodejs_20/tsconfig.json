{
    "compilerOptions": {
        "module": "commonjs",
        "noImplicitAny": true,
        "removeComments": true,
        "preserveConstEnums": true,
        "allowJs": true,
        "noEmit": true,
        "lib": [
            "ES2019"
        ]
    },
    "include": [
        "**/*"
    ],
    "exclude": [
        "node_modules"
    ]
}
